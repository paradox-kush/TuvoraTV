  "endpoints": ["/portal.php", "/stalker_portal/server/load.php", "/server/load.php", "/c/portal.php", "/stb/server/load.php"],
  "responses": [
    { "action": "handshake", "body": "{\"js\":{\"token\":\"token-mod\"}}" },
    { "action": "get_profile", "body": "{\"js\":{\"id\":\"12\",\"name\":\"Modules\",\"status\":0,\"auth_access\":false}}" },
    { "action": "get_modules", "body": "{\"js\":{\"modules\":{\"itv\":1,\"vod\":1}}}" },
    { "action": "get_genres", "body": "{\"js\":[{\"id\":\"1\",\"title\":\"Sports\"}]}" }
  ],
  "expect": { "requestOrder": ["handshake", "get_profile", "get_genres"] }
}
