{
  "schemaVersion": 1,
  "version": "2026-11-07.1",
  "killSwitch": { "espn": false, "sports": [], "leagues": [] },
  "sources": {
    "espn": {
      "scoreboard": "https://site.api.espn.com/apis/site/v2/sports/{path}/scoreboard?dates={yyyymmdd}",
      "summary": "https://site.api.espn.com/apis/site/v2/sports/{path}/summary?event={id}",
      "refresh": { "liveMs": 15000, "summaryMs": 60000, "idleMs": 0, "minMs": 6000 },
      "deadlineMs": 8000
    }
  },
  "pathSyntax": "a.b[0].c[*].d | [key=value] filter | [-1] last | missing -> null, never throws",
  "states": { "pre": "upcoming", "in": "live", "post": "final" },
  "leagues": [
